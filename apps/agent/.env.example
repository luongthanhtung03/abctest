# Backend the agent pulls jobs from. On the real Mac mini: https://<internal-system>/api
API_URL=http://localhost:4000
AGENT_API_KEY=dev-agent-key-change-me
AGENT_ID=macmini-1
POLL_INTERVAL_MS=5000
# mock = rule-based text normalisation; codex = call Codex CLI (`codex exec`) on this machine
AI_MODE=mock
AI_TIMEOUT_MS=60000
TEMPLATES_DIR=./templates
TMP_DIR=./tmp
# Demo only: SIMULATE_FAIL=1 makes every job fail with a retryable error
SIMULATE_FAIL=0
